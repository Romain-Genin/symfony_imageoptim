{
    "name": "romain-genin/symfony-image-optimizer-bundle",
    "description": "Symfony bundle that losslessly optimizes every uploaded image (weight, format, metadata) and serves device-adapted responsive variants (AVIF/WebP, srcset, Client Hints).",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "bundle",
        "image",
        "optimization",
        "upload",
        "webp",
        "avif",
        "lossless",
        "responsive",
        "srcset",
        "accessibility",
        "a11y",
        "alt-text"
    ],
    "homepage": "https://github.com/Romain-Genin/symfony_imageoptim",
    "license": "MIT",
    "authors": [
        {
            "name": "Romain Genin",
            "email": "romaingenin@icloud.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Romain-Genin/symfony_imageoptim/issues",
        "source": "https://github.com/Romain-Genin/symfony_imageoptim"
    },
    "require": {
        "php": ">=8.1",
        "ext-zlib": "*",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
        "symfony/filesystem": "^6.4|^7.0|^8.0",
        "symfony/finder": "^6.4|^7.0|^8.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/process": "^6.4|^7.0|^8.0",
        "symfony/routing": "^6.4|^7.0|^8.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "symfony/browser-kit": "^6.4|^7.0|^8.0",
        "symfony/mime": "^6.4|^7.0|^8.0",
        "symfony/twig-bundle": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "ext-gd": "Required for format conversion fallbacks and responsive variants (WebP/AVIF/JPEG encoding, resizing)",
        "symfony/twig-bundle": "Enables the responsive_image() / image_variant_url() Twig functions"
    },
    "autoload": {
        "psr-4": {
            "RomainGenin\\ImageOptimizerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RomainGenin\\ImageOptimizerBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    }
}
